# Connect to Supabase via connection pooling with Supavisor.
DATABASE_URL="postgres://postgres.[YOUR_DATABASE]:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations.
DIRECT_URL="postgres://postgres.[YOUR_DATABASE]:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Better Auth
BETTER_AUTH_SECRET="secret_key"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Optional database tuning. Local development defaults to 1 connection to avoid
# exhausting small hosted PostgreSQL pools during CDP screenshot runs.
POSTGRES_MAX_CONNECTIONS="1"

# AI provider keys
DUOMI_API=""
KIE_AI_API_KEY=""
GOOGLE_GEMINI_API_KEY=""

# Cloudflare R2 object storage
# S3 API endpoint of the account, e.g. https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=""
# Token scoped to the two buckets below with "Object Read & Write"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Private bucket for user works; the app signs time-limited links
R2_USER_ASSETS_BUCKET="sora2-user-assets"
# Public bucket for the xiaoxiaodong inspiration catalog (used by
# tools/publish-xiaoxiaodong-gallery.mjs) and its custom domain
R2_GALLERY_BUCKET="sora2-gallery"
R2_GALLERY_PUBLIC_URL=""
# Where the app reads the catalog from, e.g. <R2_GALLERY_PUBLIC_URL>/gallery/xiaoxiaodong
NEXT_PUBLIC_XIAOXIAODONG_GALLERY_BASE=""

# Legacy Supabase Storage host. Objects were copied to R2 under the same
# paths; this is only used to recognise old full URLs stored in the database.
NEXT_PUBLIC_SUPABASE_URL=""

# Optional social login providers. First enable the master switch in
# src/lib/auth/login-options.ts, then configure both values for each provider.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
